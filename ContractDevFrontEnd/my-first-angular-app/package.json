        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@angular/animations": "^21.2.8",
    "@angular/cdk": "~21.1.3",
    "@angular/common": "^21.2.5",
    "@angular/compiler": "^21.2.5",
    "@angular/core": "^21.2.5",
    "@angular/forms": "^21.2.5",
    "@angular/material": "~21.1.3",
    "@angular/platform-browser": "^21.2.5",
    "@angular/router": "^21.2.5",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@ng-bootstrap/ng-bootstrap": "^20.0.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "ionicons": "^8.0.13",
    "jwt-decode": "^4.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.4.5",
    "@angular-devkit/build-angular": "^21.2.7",
    "@angular/build": "^21.1.1",
    "@angular/cli": "^21.1.1",
    "@angular/compiler-cli": "^21.2.5",
    "@angular/localize": "^21.2.5",
    "@angular/material": "^21.1.3",
    "@testing-library/angular": "^16.0.0",
    "@testing-library/dom": "^10.4.1",
    "@types/bootstrap": "^5.2.10",
    "@vitest/ui": "^4.1.4",
    "jsdom": "^27.4.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.4"
  }
}
